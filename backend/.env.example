# Em runtime o Node APENAS carrega o ficheiro ".env" na pasta backend (não este .env.example).
# Copia para ".env" e coloca aqui a tua MONGO_URI (ex.: Atlas). O .env.example serve só de modelo.
#MONGO_URI=mongodb://127.0.0.1:27017/saude-na-mao
# Se o Atlas falhar (IP / rede): Mongo local — na pasta backend executa "docker compose up -d"
# e usa a linha abaixo como MONGO_URI; depois "node seed.js".

PORT=5000

JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=884559887672-dame54l9h1rm6dpj3mcdjhfrm1cbfqse.apps.googleusercontent.com
# Em produção, use a URL do Vercel. Para mais de uma origem, separe por vírgula.
# FRONTEND_URLS=https://seu-projeto.vercel.app,https://www.seudominio.com
NODE_ENV=development

# E-mail transacional para recuperação de senha e login por código.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=contato@seudominio.com
EMAIL_PASS=sua_senha_de_app

# Segurança regulatória do TCC:
# true = deixa claro que é protótipo acadêmico e registra pedidos como demo.
TCC_DEMO_MODE=true
# false = bloqueia checkout remoto de medicamentos controlados.
ALLOW_CONTROLLED_REMOTE_SALE=false
# true = exige alvará/AFE/responsável técnico antes de aceitar pedido real.
REQUIRE_PHARMACY_COMPLIANCE_DOCS=false

# Base pública usada para montar URLs de uploads em produção.
PUBLIC_BASE_URL=
